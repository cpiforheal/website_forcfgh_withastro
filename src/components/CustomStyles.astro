<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter), 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
    --aw-font-serif: var(--font-inter), 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
    --aw-font-heading: var(--font-inter), 'Noto Sans SC', 'Microsoft YaHei', sans-serif;

    --aw-color-primary: rgb(18 61 58);
    --aw-color-secondary: rgb(31 91 84);
    --aw-color-accent: rgb(220 103 50);
    --aw-color-text-heading: rgb(20 35 33);
    --aw-color-text-default: rgb(49 65 61);
    --aw-color-text-muted: rgb(94 111 105);
    --aw-color-bg-page: rgb(250 249 246);
    --aw-color-bg-page-dark: rgb(18 35 33);

    ::selection {
      background-color: rgb(220 103 50 / 24%);
    }
  }

  html {
    background: #faf9f6;
  }

  body {
    letter-spacing: 0;
  }

  .dark {
    --aw-color-primary: rgb(87 157 145);
    --aw-color-secondary: rgb(111 185 170);
    --aw-color-accent: rgb(238 133 79);
    --aw-color-text-heading: rgb(247 249 246);
    --aw-color-text-default: rgb(225 234 229);
    --aw-color-text-muted: rgb(177 198 190);
    --aw-color-bg-page: rgb(18 35 33);
  }
</style>
